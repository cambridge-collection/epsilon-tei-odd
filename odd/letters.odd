                               <publicationStmt>
                                   <publisher>CUP</publisher>
                                   <pubPlace>Cambridge</pubPlace>
                                   <date when="2015">2015</date>
                               </publicationStmt>
                           </egXML>
                       </exemplum>
                       <remarks versionDate="2015-08-16" xml:lang="en">
                           <p>This element is generated automatically before transcription begins.</p>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec ident="pubPlace" module="core" mode="change">
                       <desc versionDate="2015-08-16" xml:lang="en">gives the place of publication of the volume of The Correspondence of Charles Darwin containing this letter. This is invariably ‘Cambridge’.</desc>
                       <classes mode="change">
