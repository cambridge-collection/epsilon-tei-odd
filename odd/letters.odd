                   <elementSpec module="core" ident="sic" mode="change">
                       <!-- This element is used twice in the entire corpus 11236 and 11247. It is not displayed differently so I'm wondering whether it might just be best to remove these tags from the file and add a comment, if anything -->
                       <desc xml:lang="en" versionDate="2016-07-10">indicates that the text, although apparently incorrect, is being reproduced accurately. It replaces the use of TNOTES to flag potentially problematic text for editorial check.</desc>
                       <attList>
                           <attDef ident="cert" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="resp" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="n" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rend" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:id" mode="delete"/>
                           <attDef ident="xml:lang" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">saw them loading <sic resp="#els" cert="high">waggons</sic> with the slates</egXML>
                       </exemplum>
                       <remarks xml:lang="en" versionDate="2016-07-10">
                           <p>Text marked up with <gi>sic</gi> will not appear styled or in any way special on either the live site or the final InDesign proofs. However, it will be flagged on the dev XTF instance and proofing galleys. To indicate that a particularly problematic word has been throughly checked and confirmed, change <att>resp</att> to ‘<val>#seniorEditor</val>’. Remember, of course, to ensure that a <gi>name</gi> element with <att>xml:id</att> of ‘<val>seniorEditor</val>’ is defined within a <gi>change</gi> element within <gi>revisionDesc</gi>.</p>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec ident="title" module="core" mode="change">
                       <desc versionDate="2014-06-29" xml:lang="en">contains the title (letter header) of the electronic document.</desc>
                       <classes mode="change">
