                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <title>From R.&#160;F.&#160;Cooke&#160;&#160;29&#160;May&#160;1875</title>
                           </egXML>
                       </exemplum>
                       <remarks versionDate="2014-06-11" xml:lang="en">
                           <p>This element appears in several contexts throughout the files (such as <gi>seriesStmt</gi>), only the version in <gi>titleStmt</gi> should be edited by editors.</p>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec module="core" ident="unclear" mode="change">
                       <desc versionDate="2020-08-15" xml:lang="en">indicates a doubtful reading of the text that cannot be transcribed with certainty. It is rendered as roman text within italicised square braces online and in print.</desc>
                       <classes mode="change">
                           <memberOf key="att.dimensions" mode="delete"/>
                           <memberOf key="att.editLike" mode="delete"/>
                           <memberOf key="att.global" mode="delete"/>
                       </classes>
                       <attList>
                           <attDef ident="agent" mode="delete"/>
                           <attDef ident="reason" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">… as inhabitants of water—or plants <unclear>drawing nourishment</unclear> from soil …</egXML>
                           <p>Renders as: “… as inhabitants of water—or plants <hi rend="italic">[</hi>drawing nourishment<hi rend="italic">]</hi> from soil …”.</p>
                       </exemplum>
                       <remarks xml:lang="en" versionDate="2016-07-10">
                           <p/>
                       </remarks>
                   </elementSpec>
                   
                   <!--Elements from textstructure-->
                   
                   <elementSpec module="textstructure" ident="back" mode="change">
                       <classes mode="change">
                           <memberOf key="att.declaring" mode="delete"/>
                           <memberOf key="att.global" mode="delete"/>
                       </classes>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples"/>
                       </exemplum>
                       <remarks xml:lang="en" versionDate="2022-10-11">
                           <p/>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec module="textstructure" ident="body" mode="change">
                       <classes mode="change">
                           <memberOf key="att.declaring" mode="delete"/>
                           <memberOf key="att.global" mode="delete"/>
                       </classes>
                       <exemplum xml:lang="eng">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <body>
                                   <div type="letter">
                                       <div type="text">
                                           <opener>
                                               <![CDATA[<!-- contains the information printed at the top of the letter -->]]>
                                           </opener>
                                           <div type="transcription">
                                               <![CDATA[<!-- the letter content goes here -->]]>
                                           </div>
                                       </div>
                                       <div type="enclosure">
                                           <![CDATA[<!-- contains a transcription of a single enclosure. This div is optional 
                                               and should only be included when the file letter has an enclosure -->]]>
                                       </div>
                                       <div type="enclosure">
                                           <![CDATA[<!-- If there are multiple enclosures, multiple just create an additional
                                               sibling div/@type="enclosure" for each one -->]]>
                                       </div>
                                       <div type="cdnotes">
                                           <![CDATA[<!-- This div is optional and only to be used if the file contains contains 
                                               one or more 'cdnotes' -->]]>
                                           <note type="annotation"><![CDATA[<!-- contents of first CD Note goes here-->]]></note>
                                           <note type="annotation"><![CDATA[<!-- contents of second CD Note goes here-->]]></note>
                                       </div>
                                       <div type="annotations">
                                           <![CDATA[<!-- This div is optional and only to be used if the file contains contains 
                                               one or more 'annotations' -->]]>
                                           <note type="annotation"><![CDATA[<!-- contents of first annotation goes here-->]]></note>
                                           <note type="annotation"><![CDATA[<!-- contents of second annotation goes here-->]]></note>
                                       </div>
                                   </div>
                                   <div type="translation">
                                       <![CDATA[<!-- div/@type='translation' is optional and need only be included
                                           when a translation is being provided -->]]>
                                       <div type="text">
                                           <opener>
                                               <![CDATA[<!-- contains a translation of the information printed at the
                                                   top of the letter -->]]>
                                           </opener>
                                           <div type="transcription">
                                               <![CDATA[<!-- the translated letter content goes here -->]]>
                                           </div>
                                       </div>
                                       <div type="enclosure" subtype="other">
                                           <![CDATA[<!-- This element is optional. It is ONLY needed if you need to 
                                               translate an enclosure.
                                               @subtype is required to indicate the type of content the
                                               enclosure contains: 'letter', 'translation' or 'other'
                                               If you need to translate enclosures, just create a
                                               div/@type="enclosure" for each one to be translated.
                                           -->]]>
                                       </div>
                                   </div>
                                   <div type="footnotes">
                                       <![CDATA[<!-- This div is optional and should only be included if the edited letter 
                                           contains one or more notes -->]]>
                                       <note type="footnote" xml:id="foot-1000.f1"><![CDATA[<!-- note content goes here -->]]></note>
                                       <note type="footnote" xml:id="foot-1000.f2"><![CDATA[<!-- note content goes here -->]]></note>
                                   </div>
                               </body>
                           </egXML>
                       </exemplum>
                   </elementSpec>
                   
                   <elementSpec module="textstructure" ident="closer" mode="change">
                       <classes mode="change">
                           <memberOf key="att.global" mode="delete"/>
                           <memberOf key="att.written" mode="delete"/>
                       </classes>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples"/>
                       </exemplum>
                       <remarks xml:lang="en" versionDate="2022-10-11">
                           <p/>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec ident="div" module="textstructure" mode="change">
                       <desc versionDate="2014-06-09" xml:lang="en">contains either the whole of a text or a subdivision of it.</desc>
                       <classes mode="change">
                           <memberOf key="att.declaring" mode="delete"/>
                           <memberOf key="att.divLike" mode="delete"/>
                       </classes>
                       <constraintSpec ident="div-position-check" scheme="schematron">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:div[@type]">
                                   <report test="@type=('footnotes','letter','translation') and not(parent::tei:body)">ERROR: <value-of select="@type"/> div must be a child of body</report>
                                   <report test="@type=('cdnotes', 'annotations', 'tnotes') and not(parent::tei:div[@type='letter'])">ERROR: <value-of select="@type"/> div must be a child of div/@type=letter</report>
                                   <report test="@type=('enclosure','text') and not(parent::tei:div[@type=('letter','translation')])">ERROR: <value-of select="@type"/> div must be a child of either div/@type=letter or translation</report>
                                   <report test="@type=('transcription') and not(parent::tei:div[@type=('text','translation', 'enclosure')])">ERROR: <value-of select="@type"/> div must be a child of either div/@type=text, translation or enclosure</report>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <attList>
                           <attDef ident="hand" mode="change"/>
                           <attDef ident="n" mode="change"><!-- TODO: REMOVE FROM FILES -->
                               <desc versionDate="2016-05-07" xml:lang="en">marks the enclosure number (deprecated). This attribute is no longer needed as enclosures are now automatically numbered.</desc>
                           </attDef>
                           <attDef ident="subtype" mode="change">
                               <desc versionDate="2016-05-07" xml:lang="en">marks the subtype of an enclosure. Valid values include '<val>letter</val>'<!--, '<val>translation</val>'--> and '<val>other</val>.</desc>
                               <valList type="closed" mode="replace">
                                   <valItem ident="letter"/>
                                   <valItem ident="other"/>
                                   <valItem ident="translation"/>
                               </valList>
                           </attDef>
                           <attDef ident="type" mode="change">
                               <desc versionDate="2016-05-07" xml:lang="en">marks the type of division in the transcription. Valid values include '<val>annotations</val>', '<val>cdnotes</val>', '<val>enclosure</val>', '<val>footnotes</val>', '<val>letter</val>', '<val>text</val>', '<val>tnotes</val>', '<val>transcription</val>' and '<val>translation</val>.</desc>
                               <valList type="closed" mode="replace">
                                   <valItem ident="annotations"/>
                                   <valItem ident="cdnotes"/>
                                   <valItem ident="enclosure"/>
                                   <valItem ident="footnotes"/>
                                   <valItem ident="letter"/>
                                   <valItem ident="text"/>
                                   <valItem ident="tnotes"/>
                                   <valItem ident="transcription"/>
                                   <valItem ident="translation"/>
                               </valList>
                           </attDef>
                           <attDef ident="xml:id" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="cert" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rend" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="resp" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:lang" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               
                               
                           </egXML>
                       </exemplum>
                       <remarks versionDate="2014-05-27" xml:lang="en">
                           <p/>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec module="textstructure" ident="opener" mode="change">
                       <desc versionDate="2016-05-07" xml:lang="en">contains a transcription of the opening information from the letter, namely the place the letter was written (<gi>placeName</gi>), its date (<gi>date</gi>) and salutation (<gi>salute</gi>)</desc>
                       <classes mode="change">
                           <memberOf key="att.global" mode="delete"/>
                           <memberOf key="att.written" mode="delete"/>
                       </classes>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <opener>
                                   <placeName>Cambridge</placeName>
                                   <date>Wednesday</date>
                                   <salute>My dear Fox</salute>
                               </opener>
                           </egXML>
                       </exemplum>
                       <exemplum xml:lang="en">
                           <p><gi>opener</gi> contain faithful transcriptions of the opening information as they appear in the letter, so be sure to include all the revelvant formatting.</p>
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <opener>
                                   <placeName>[Down House]</placeName>
                                   <date>24<hi rend="superscript">th</hi>. August&#160;1875</date>
                                   <salute>My dear Sir</salute>
                               </opener>
                           </egXML>
                       </exemplum>
                       <exemplum xml:lang="en">
                           <p>If a certain piece of information, such as <gi>placeName</gi>, is not included or inferable, then its corresponding element should be omitted.</p>
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <opener>
                                   <salute>My dear M<hi rend="superscript">r</hi>. Charles</salute>
                               </opener>
                           </egXML>
                       </exemplum>
                       <remarks versionDate="2016-05-07" xml:lang="en">
                           <p>The regularised metadata versions of this information belong in <gi>correspDesc</gi>.</p>
                       </remarks>
                   </elementSpec>
                   
