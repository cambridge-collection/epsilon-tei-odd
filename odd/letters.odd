                   <elementSpec module="transcr" ident="supplied" mode="change">
                       <!-- This appears twice in the entire corpus (9220 and 9383). In both instances, it's in date and should
                           likely just be changed to [TEXT], which is how it's done elsewhere.
                       -->
                       <desc versionDate="2007-08-29" xml:lang="en">signifies text that the editor has supplied to the transcription for any reason. If not <att>reason</att> is given, the text will be rendered as ‘[text]’. If <tag>reason="damage"</tag> it will be rendered as '〈text〉'/</desc>
                       <classes mode="change">
                           <memberOf key="att.dimensions" mode="delete"/>
                           <memberOf key="att.editLike" mode="delete"/>
                       </classes>
                       <attList>
                           <attDef ident="reason" usage="opt" mode="change">
                               <desc versionDate="2013-12-06" xml:lang="en">describes why the text has had to be supplied. The only value currently allowed is ‘<val>damage</val>’, which will be rendered as 〈some text〉.</desc>
                               <valList type="closed" mode="replace">
                                   <valItem ident="damage">
                                       <desc xml:lang="en" versionDate="2016-07-10">indicates that text is being supplied because of damage in the original document. It will be output as 〈some text〉.</desc>
                                   </valItem>
                               </valList>
                           </attDef>
                           <attDef ident="resp" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="cert" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="n" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rend" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:id" mode="delete"/>
                           <attDef ident="xml:lang" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <opener>
                                   <placeName>
                                       <hi rend="print">Down | Beckenham, Kent.</hi>
                                       <supplied reason="editorial">Abinger</supplied>
                                   </placeName> 
                                   …</opener>
                           </egXML>
                           <p>Renders as: “<hi rend="italic">Down | Beckenham, Kent.</hi> [Abinger]”.</p>
                       </exemplum>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">and into the barrel, the <supplied reason="damaged">grain</supplied> thus becoming saturated</egXML>
                           <p>Renders as: “and into the barrel, the 〈grain〉 thus becoming saturated”.</p>
                       </exemplum>
                   </elementSpec>
                   
