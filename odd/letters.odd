                   <elementSpec module="textstructure" ident="signed" mode="change">
                       <classes mode="change">
                           <memberOf key="att.global" mode="delete"/>
                           <memberOf key="att.written" mode="delete"/>
                       </classes>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples"/>
                       </exemplum>
                       <remarks xml:lang="en" versionDate="2022-10-11">
                           <p/>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec ident="TEI" module="textstructure" mode="change">
                       <desc xml:lang="en" versionDate="2016-05-06">is the parent element containing the whole of the electronic file, both metadata and transcription.</desc>
                       <classes mode="change">
                           <memberOf key="att.typed" mode="delete"/>
                       </classes>
                       <constraintSpec ident="correspaction-required" scheme="schematron">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:TEI">
                                   <assert test="count(//tei:correspDesc) eq 1">ERROR: <name/> is required for describing correspondence details</assert>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <attList>
                           <attDef ident="xml:id" usage="req" mode="change">
                               <desc xml:lang="en" versionDate="2016-05-06">contains the canonical identifier for the document. This identifier, which also serves as the document’s filename, takes the form DCP-LETT- followed by the calendar number for the letter. For example, DCP-LETT-123. Any letters in the calendar number must be uppercase.</desc>
                           </attDef>
                           <attDef ident="xml:lang" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="cert" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="n" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rend" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="resp" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="version" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:space="preserve">
                               <TEI xml:id="DCP-LETT-10000">
                                   <teiHeader>
                                       <fileDesc>
                                           <![CDATA[<!-- fileDesc contains information about the file, its source and
                                           its published versions -->]]>
                                           <titleStmt/>
                                           <publicationStmt/>
                                           <seriesStmt/>
                                           <sourceDesc/>
                                       </fileDesc>
                                       
                                       <profileDesc>
                                           <![CDATA[<!-- profileDesc contains the bulk of the metadata transcriptions -->]]>
                                           <correspDesc>
                                               <![CDATA[<!-- contains information about the correspondence exchange -->]]>
                                           </correspDesc>
                                           <abstract>
                                               <![CDATA[<!-- contains a summary of the item -->]]>
                                           </abstract>
                                           <textClass>
                                               <![CDATA[<!-- contains the categories assigned to a letter -->]]>
                                           </textClass>
                                       </profileDesc>
                                       
                                       <revisionDesc>
                                           <![CDATA[<!-- contains information about the changes made to the XML file -->]]>
                                       </revisionDesc>
                                   </teiHeader>
                                   
                                   <text>
                                       <body>
                                           <div type="letter">
                                               <div type="text">
                                                   <opener>
                                                       <![CDATA[<!-- contains the information printed at the top of the letter -->]]>
                                                   </opener>
                                                   <div type="transcription">
                                                       <![CDATA[<!-- the letter content goes here -->]]>
                                                   </div>
                                               </div>
                                               
                                               <div type="enclosure">
                                                   <![CDATA[<!-- contains a transcription of a single enclosure. This div is optional 
                                                   and should only be included when the file letter has an enclosure -->]]>
                                               </div>
                                               
                                               <div type="enclosure" subtype="other">
                                                   <![CDATA[<!-- If there are multiple enclosures, multiple just create an additional
                                                   sibling div/@type="enclosure" for each one -->]]>
                                                   <![CDATA[<!--  @subtype is required to indicate the type of content the
                                                   enclosure contains: 'letter', 'translation' or 'other'
                                                   If you need to translate enclosures, just create a
                                                   div/@type="enclosure" for each one to be translated.
                                                   -->]]>
                                               </div>
                                               
                                               <div type="cdnotes">
                                                   <![CDATA[<!-- This div is optional and only to be used if the file contains contains 
                                                   one or more 'cdnotes' -->]]>
                                                   <note type="annotation"><![CDATA[<!-- contents of first CD Note goes here-->]]></note>
                                                   <note type="annotation"><![CDATA[<!-- contents of second CD Note goes here-->]]></note>
                                               </div>
                                               
                                               <div type="annotations">
                                                   <![CDATA[<!-- This div is optional and only to be used if the file contains contains 
                                                   one or more 'annotations' -->]]>
                                                   <note type="annotation"><![CDATA[<!-- contents of first annotation goes here-->]]></note>
                                                   <note type="annotation"><![CDATA[<!-- contents of second annotation goes here-->]]></note>
                                               </div>
                                           </div>
                                           
                                           <div type="translation">
                                               <![CDATA[<!-- div/@type='translation' is optional and need only be included
                                               when a translation is being provided -->]]>
                                               <div type="text">
                                                   <opener>
                                                       <![CDATA[<!-- contains a translation of the information printed at the
                                                       top of the letter -->]]>
                                                   </opener>
                                                   <div type="transcription">
                                                       <![CDATA[<!-- the translated letter content goes here -->]]>
                                                   </div>
                                               </div>
                                               <div type="enclosure">
                                                   <![CDATA[<!-- This element is optional. It is ONLY needed if you need to 
                                                   translate an enclosure.
                                                   If you need to translate enclosures, just create a
                                                   div/@type="enclosure" for each one to be translated.
                                                   -->]]>
                                               </div>
                                           </div>
                                           
                                           <div type="footnotes">
                                               <![CDATA[<!-- This div is optional and should only be included if the edited letter 
                                               contains one or more notes -->]]>
                                               <note type="footnote" xml:id="foot-10000.f1"><![CDATA[<!-- note content goes here -->]]></note>
                                               <note type="footnote" xml:id="foot-10000.f2"><![CDATA[<!-- note content goes here -->]]></note>
                                           </div>
                                       </body>
                                   </text>
                               </TEI>
                           </egXML>
                       </exemplum>
                   </elementSpec>
                   
