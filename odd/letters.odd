                   <elementSpec module="core" ident="gap" mode="change">
                       <desc versionDate="2008-01-24" xml:lang="en">indicates a point in the letter where the text remains wholly indecipherable and could be transcribed at all. When <tag>reason="illeg"</tag>, it renders as italicised square braces surrounding the contents of <att>extent</att>. When <tag>reason="damage"</tag> it renders as pointed brackets surrounding either two or four non-breaking spaces depending on the value of <att>unit</att>.</desc>
                       <classes mode="change">
                           <memberOf key="att.editLike" mode="delete"/>
                           <memberOf key="att.global" mode="delete"/>
                           <memberOf key="att.timed" mode="delete"/>
                       </classes>
                       <constraintSpec ident="gap-reason-check" scheme="schematron">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:gap">
                                   <report test="@reason = 'illeg'and @unit">ERROR: @unit cannot be used when @reason='illeg'</report>
                                   <report test="@reason = 'damage'and @extent">ERROR: @extent cannot be used when @reason='damage'</report>
                                   <report test="@reason = 'illeg' and not(normalize-space(@extent))">ERROR: @extent needs to have a value, which will be displayed in italic between square braces, when @reason='illeg'</report>
                                   <report test="@reason = 'damage' and not(normalize-space(@unit))">ERROR: @unit needs to have a value of partialWord or Word when @reason='damage'</report>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <constraintSpec ident="gap-extent-check" scheme="schematron">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:gap[@extent]">
                                   <report test="@unit">ERROR: @unit cannot be used with @extent</report>
                                   <report test="@reason != 'illeg'">ERROR: @extent must be used with @reason='illeg'</report>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <constraintSpec ident="gap-unit-check" scheme="schematron">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:gap[@unit]">
                                   <report test="@unit and not(@reason='damage')">ERROR: @unit must be used with @reason='damage'</report>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <attList>
                           <attDef ident="extent" mode="change" usage="opt">
                               <desc versionDate="2014-05-21" xml:lang="en">records the extent of the omission. This is the text that would appear in italic between italicised square braces.</desc>
                           </attDef>
                           <attDef ident="reason" usage="req" mode="change">
                               <desc versionDate="2005-01-14" xml:lang="en">indicates why the material could not be transcribed. Values are "<val>damage</val>" (renders with '〈' and '〉') or "<val>illeg</val>" (renders with italicised square braces).</desc>
                               <valList type="closed" mode="replace">
                                   <valItem ident="illeg">
                                       <desc xml:lang="en" versionDate="2016-07-18">text is illegible for any reason other than 'damage'. Used when italicised [some text] is desired.</desc>
                                   </valItem>
                                   <valItem ident="damage">
                                       <desc xml:lang="en" versionDate="2016-07-18">text has been rendered illegible by damage. Use when two or foud non-breaking spaces between '〈' and '〉' are required.</desc>
                                   </valItem>
                               </valList>
                           </attDef>
                           <attDef ident="unit" mode="change" usage="opt">
                               <desc versionDate="2014-05-21" xml:lang="en">defines the 'units' the undecipherable text. Permitted values: "<val>partialWord</val>" (renders as two non-breaking spaces), and "<val>word</val>" (renders as four non-breaking spaces). Only to be used when <tag>reason="damaged"</tag></desc>
                               <valList type="closed" mode="replace">
                                   <valItem ident="partialWord"/>
                                   <valItem ident="word"/>
                               </valList>
                           </attDef>
                           <attDef ident="agent" mode="delete"/>
                           <attDef ident="atLeast" mode="delete"/>
                           <attDef ident="atMost" mode="delete"/>
                           <attDef ident="confidence" mode="delete"/>
                           <attDef ident="max" mode="delete"/>
                           <attDef ident="min" mode="delete"/>
                           <attDef ident="precision" mode="delete"/>
                           <attDef ident="quantity" mode="delete"/>
                           <attDef ident="scope" mode="delete"/>
                       </attList>
                   </elementSpec>
                   
                   <elementSpec module="core" ident="graphic" mode="change">
                       <desc xml:lang="en" versionDate="2022-07-05">indicates the location of a graphic or illustration. It must be placeed within <gi>figure</gi> when used for images within the transcribed text. Facsimile images of the entire page are placed within <gi>facsimile</gi> as per the Transcription Guidelines.</desc>
                       <classes mode="change">
                           <memberOf key="att.typed" mode="delete"/>
                       </classes>
                       <attList>
                           <attDef ident="decls" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="height" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="rend" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="resp" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="url" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="width" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="cert" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="mimeType" mode="delete"/>
                           <attDef ident="n" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="scale" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:id" mode="delete"/>
                           <attDef ident="xml:lang" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <figure rend="blockCentred width95">
                                   <graphic url="../images/DCP-LETT-9024-1.svg"/>
                               </figure>
                           </egXML>
                       </exemplum>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <facsimile>
                                   <graphic decls="#document-thumbnail" rend="portrait" url="https://images.lib.cam.ac.uk/content/images/MS-DAR-00160-000-00870_files/8/0_0.jpg" width="3128px" height="5185px"/>
                                   <graphic decls="#preview-tile-zoomed" rend="portrait" url="https://images.lib.cam.ac.uk/content/images/MS-DAR-00160-000-00870_files/11/1_1.jpg" width="3128px" height="5185px"/>
                                   <surface n="210:1r" xml:id="i870">
                                       <graphic decls="#downloadImageRights #download" rend="portrait" url="https://images.lib.cam.ac.uk/content/images/MS-DAR-00160-000-00870.jpg" width="3128px" height="5185px"/>
                                       <graphic decls="#thumbnail" rend="portrait" url="https://images.lib.cam.ac.uk/content/images/MS-DAR-00160-000-00870_files/8/0_0.jpg" width="3128px" height="5185px"/>
                                       <graphic decls="#display" rend="portrait" url="https://images.lib.cam.ac.uk/content/images/MS-DAR-00160-000-00870.dzi" width="3128px" height="5185px"/>
                                   </surface>
                               </facsimile>
                           </egXML>
                       </exemplum>
                       <remarks xml:lang="en" versionDate="2022-07-05">
                           <p>The block alignment and size of the image within the transcribed text are indicated with its parent <gi>figure</gi>.</p>
                           <p>When <gi>graphic</gi> is contained within <gi>facsimile</gi>, its purpose is specified using its <att>decls</att>.</p>
                           <p>If <gi>graphic</gi> appears directly within <gi>facsimile</gi>, it points to a thumbnail or preview image (as defined by its <att>decls</att>) for the document as a whole. When it instead appears within <gi>surface</gi>, it provides various digital images of an individual page whose purpose is defined by its <att>decls</att>.</p>
                       </remarks>
                   </elementSpec>
                   
