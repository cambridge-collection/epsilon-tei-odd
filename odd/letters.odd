                       </classes>
                       <attList>
                           <attDef ident="rend" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="type" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="xml:lang" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="cert" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="n" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="resp" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="subtype" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:id" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples"/>
                       </exemplum>
                       <remarks versionDate="2016-05-06" xml:lang="en">
                           <p>The use of this element within the Darwin Correspondence Project is uncertain due to how its predecessor was used within DarXML. It should not be used until these issues are resolved by the editors.</p>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec ident="ref" module="core" mode="change">
                       <classes mode="change">
                           <memberOf key="att.cReferencing" mode="delete"/>
                           <memberOf key="att.declaring" mode="delete"/>
                           <memberOf key="att.internetMedia" mode="delete"/>
                       </classes>
                       <constraintSpec ident="ref-note-check_pointer" scheme="schematron" mode="add">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:ref[not(matches(@target,'^#tnote'))][matches(@target,'^#')]">
                                   <let name="notes" value="./ancestor::tei:TEI//tei:div[@type='footnotes']//tei:note"/>
                                   <assert test="@target = $notes/concat('#',@xml:id)">ERROR: <name/>@target must be a valid pointer to a note/@xml:id</assert>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <constraintSpec ident="ref-in-ref" scheme="schematron" mode="add">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:ref">
                                   <report test="descendant::tei:ref">ERROR: <name/> contains another <name/></report>
                                   <report test="ancestor::tei:ref">ERROR: <name/> inside another <name/></report>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <constraintSpec ident="ref-check_single_resource_pointer" scheme="schematron" mode="add">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:ref[normalize-space(@target)][not(matches(normalize-space(@target),'\s+'))][matches(@target,'^.+\.xml$')]">
                                   <let name="document_uri" value="string-join(tokenize(document-uri(/),'/')[position() != last()],'/')"/>
                                   <assert test="doc-available(concat($document_uri,'/',@target))">ERROR: <name/> points to a non-existent file (<value-of select="@target"/>)</assert>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <attList>
                           <attDef ident="cert" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="rend" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="resp" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="target" usage="req" mode="change">
                               <desc xml:lang="en" versionDate="2016-06-30">points to either to a footnote (eg. #foot.f1), or another file in our collection (eg. ../letters/DCP-LETT-1.xml or ../nameregs/nameregs_1.xml) or to an external resource (http://....)".</desc>
                               <datatype><rng:data type="string">
                                   <rng:param name="pattern">(#.+|https*://.+|.+\.xml(#\S+)*|)</rng:param>
                               </rng:data>
                               </datatype>
                           </attDef>
                           <attDef ident="type" mode="change">
                               <!--NEW-->
                           </attDef>
                           <attDef ident="ana" mode="delete"/>
                           <attDef ident="change" mode="delete"/>
                           <attDef ident="copyOf" mode="delete"/>
                           <attDef ident="corresp" mode="delete"/>
                           <attDef ident="evaluate" mode="delete"/>
                           <attDef ident="exclude" mode="delete"/>
                           <attDef ident="facs" mode="delete"/>
                           <attDef ident="n" mode="delete"/>
                           <attDef ident="next" mode="delete"/>
                           <attDef ident="prev" mode="delete"/>
                           <attDef ident="rendition" mode="delete"/>
                           <attDef ident="sameAs" mode="delete"/>
                           <attDef ident="select" mode="delete"/>
                           <attDef ident="source" mode="delete"/>
                           <attDef ident="style" mode="delete"/>
                           <attDef ident="subtype" mode="delete"/>
                           <attDef ident="synch" mode="delete"/>
                           <attDef ident="targetLang" mode="delete"/>
                           <attDef ident="xml:base" mode="delete"/>
                           <attDef ident="xml:id" mode="delete"/>
                           <attDef ident="xml:lang" mode="delete"/>
                           <attDef ident="xml:space" mode="delete"/>
                       </attList>
                       <exemplum xml:lang="en">
                           <egXML xmlns="http://www.tei-c.org/ns/Examples">
                               <ref target="#foot-10000.f1"/>
                           </egXML>
                       </exemplum>
                       <remarks versionDate="2014-06-11" xml:lang="en">
                           <p/>
                       </remarks>
                   </elementSpec>
                   
                   <elementSpec ident="relatedItem" module="core" mode="change">
                       <classes mode="change">
                           <memberOf key="att.global" mode="delete"/>
                       </classes>
                       <constraintSpec ident="type-subtype-check" scheme="schematron" mode="add">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:relatedItem[normalize-space(@subtype)]">
                                   <report test="not(@type) or normalize-space(@type)=''">ERROR: You must supply a valid @type (e.g. draft, copy, translation).</report>
                                   <report test="@type='publication' and normalize-space(@subtype) !=''">ERROR: @type='publication' usually doesn't have @subtype (one of them is likely wrong).</report>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <constraintSpec ident="check_file_pointer" scheme="schematron" mode="add">
                           <constraint>
                               <rule xmlns="http://purl.oclc.org/dsdl/schematron" context="tei:relatedItem[matches(@target,'.+\.xml$')]">
                                   <let name="document_uri" value="replace(document-uri(/),'/[^/]+$','/')"/>
                                   <assert test="doc-available(concat($document_uri,@target))">ERROR: <name/> points to a non-existent file (<value-of select="@target"/>)</assert>
                               </rule>
                           </constraint>
                       </constraintSpec>
                       <attList>
                           <attDef ident="subtype" usage="opt" mode="change">
                               <desc versionDate="2014-04-20" xml:lang="en">values should be a short canonical one word abbreviation for the institution (e.g. "<val>CUL</val>", "<val>NHM</val>", "<val>Liverpool</val>".</desc>
                           </attDef>
                           <attDef ident="target" usage="opt" mode="change">
                               <desc xml:lang="en" versionDate="2016-06-30">points to either to another letter file in our collection (eg. ../letters/DCP-LETT-1.xml or ../drafts/DCP-LETT-1234.xml).</desc>
                               <datatype><rng:data type="string">
                                   <rng:param name="pattern">.+\.xml(#\S+)*</rng:param>
                               </rng:data>
                               </datatype>
                           </attDef>
                           <attDef ident="type" usage="req" mode="change">
                               <desc versionDate="2014-04-20" xml:lang="en">values are "<val>copy</val>", "<val>draft</val>", "<val>publication</val>", and "<val>translation</val>".</desc>
                               <valList type="closed" mode="replace">
                                   <valItem ident="copy"/>
                                   <valItem ident="draft"/>
                                   <valItem ident="publication"/>
                                   <valItem ident="translation"/>
                               </valList>
                           </attDef>
                       </attList>
                   </elementSpec>
                   
